# agentd 配置示例。复制为 .env 后按需修改；.env 不入库。
# 所有变量都可以用环境变量覆盖（前缀 AGENTD_）。

# dev | test | prod
AGENTD_ENV=dev

# HTTP 监听。容器内必须 0.0.0.0
AGENTD_HOST=127.0.0.1
AGENTD_PORT=8000

# 日志：JSON 单行（生产建议 true）
AGENTD_LOG_LEVEL=INFO
AGENTD_LOG_JSON=true

# 数据目录：DB 与 workspace 都在下面（容器里挂 /data）
AGENTD_DATA_DIR=var
# 可选：显式指定 DB 与 workspace（默认 <data_dir>/agentd.db、<data_dir>/workspace）
# AGENTD_DB_PATH=var/agentd.db
# AGENTD_WORKSPACE_ROOT=var/workspace

# 启动时自动迁移（生产也建议 true，迁移失败进程不会起）
AGENTD_AUTO_MIGRATE=true

# SQLite 写锁等待
AGENTD_SQLITE_BUSY_TIMEOUT_MS=5000

# 部署用（docker compose 读取）
# AGENTD_DOMAIN=agent.example.com
# AGENTD_IMAGE_TAG=0.1.0
