# agentd 配置示例。复制为 .env 后按需修改；.env 不入库。
# 所有变量都可以用环境变量覆盖（前缀 AGENTD_）。

# dev | test | prod
AGENTD_ENV=dev

# HTTP 监听。容器内必须 0.0.0.0
AGENTD_HOST=127.0.0.1
AGENTD_PORT=8000

# 日志：JSON 单行（生产建议 true）
AGENTD_LOG_LEVEL=INFO
AGENTD_LOG_JSON=true

# 数据目录：DB 与 workspace 都在下面（容器里挂 /data）
AGENTD_DATA_DIR=var
# 可选：显式指定 DB 与 workspace（默认 <data_dir>/agentd.db、<data_dir>/workspace）
# AGENTD_DB_PATH=var/agentd.db
# AGENTD_WORKSPACE_ROOT=var/workspace

# 启动时自动迁移（生产也建议 true，迁移失败进程不会起）
AGENTD_AUTO_MIGRATE=true

# SQLite 写锁等待
AGENTD_SQLITE_BUSY_TIMEOUT_MS=5000

# 模型接入（v0.2 多 provider：openai=chat.completions / responses=Responses API /
#   anthropic=Messages API；主链重试耗尽后按 AGENTD_LLM_FALLBACKS 顺序整链切换）
AGENTD_LLM_PROVIDER=openai
# AGENTD_LLM_API_KEY=sk-...
# AGENTD_LLM_BASE_URL=https://api.openai.com/v1
# AGENTD_LLM_MODEL=gpt-4o-mini
# 备选链（可选，逗号分隔）：如 anthropic,responses
# AGENTD_LLM_FALLBACKS=
# AGENTD_ANTHROPIC_API_KEY=
# AGENTD_ANTHROPIC_BASE_URL=https://api.anthropic.com
# AGENTD_ANTHROPIC_MODEL=claude-sonnet-4-5
AGENTD_LLM_TIMEOUT_S=120
AGENTD_LLM_RETRIES=3
AGENTD_RUN_MAX_ITERATIONS=8
AGENTD_RUN_TIMEOUT_S=600
AGENTD_RUN_TOOL_TIMEOUT_S=60

# 长期记忆（v0.2-3）：注入按预算取 active；提取默认关闭（run 成功后旁路 LLM 调用）
# AGENTD_MEMORY_EXTRACT_ENABLED=false
# AGENTD_MEMORY_BUDGET_TOKENS=512
# AGENTD_MEMORY_MAX_ACTIVE=50
# AGENTD_MEMORY_STALE_DAYS=90

# 上下文预算（M2）
# AGENTD_LLM_CONTEXT_WINDOW=128000
# AGENTD_LLM_MAX_OUTPUT=4096

# MCP 服务器（v0.2）：JSON；单服务器故障自动跳过
# AGENTD_MCP_SERVERS={"fetch": {"url": "https://mcp.example/mcp", "token": "opt"}}

# shell 工具：默认关闭；开启 = 信任调用方（M2）
AGENTD_RUN_SHELL_ENABLED=false
# AGENTD_RUN_SHELL_ALLOWLIST=git,python -m pytest
# AGENTD_RUN_SHELL_TIMEOUT_S=30

# 部署用（docker compose 读取）
# AGENTD_DOMAIN=agent.example.com
# AGENTD_IMAGE_TAG=0.1.0
# ACME_EMAIL=you@example.com
# HTTP_PORT=80
# HTTPS_PORT=443

# 网络受限（Docker Hub / ghcr.io 直连不通）时切换镜像源，无需改 daemon.json
# PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim-bookworm
# UV_IMAGE=ghcr.m.daocloud.io/astral-sh/uv:0.11.16
# CADDY_IMAGE=docker.m.daocloud.io/library/caddy:2-alpine
# UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
